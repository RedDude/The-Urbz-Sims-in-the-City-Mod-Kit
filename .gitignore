# Game data: never commit (bring your own ROM)
*.nds
*.zip
/project/
/build/
/catalog/

# Emulator state and evidence (machine-local; savestates contain game RAM)
*.dst
*.dsm
verify/evidence/
verify/states/

# Your own mods/settings stay local unless you add them on purpose
mods.json
# Your Tune-window settings (mod manager)
tuning/
# The game you build (ROM and save)
/game/
emulator.txt
/emulator/

# Python
__pycache__/
*.pyc

# Mods: only the example mods are tracked; your own stay local unless you un-ignore them.
# (A mod that holds files extracted from the game must never be committed.)
mods/*
!mods/npc-life/
!mods/pets/
!mods/more-furniture/
!mods/max-needs/
!mods/bug-fixes/
!mods/phone/
!mods/cellphone/
!mods/any-romance/
!mods/friendly-topics/
!mods/moving-crate/
!mods/quick-start/
!mods/walk-style/
!mods/auto-interact/
# The phone picture (not ours: made into phone_art.inc locally, never committed)
mods/phone/phone-ts2.png
mods/phone/code/phone_art.inc
mods/npc-life/sim/orig_tables.h
tests/mods/*/code/build/
verify/melonds/
mods/pets/art/

# Your own copies of other games (urbz_import.py): local only
sources.json
