# Named addresses in The Urbz DS (USA) found by reverse engineering.
# Used by hooks.txt (names instead of numbers) and by C code via game.h.
# Evidence for each is in docs/systems.md.

# --- engine
get_asset          = 0x02032CA8   # void *get_asset(int game_id, int flags, int unpack): loads (once) and returns the asset in RAM
decode_chunk       = 0x0202D83C   # u32 decode_chunk(const u32 *chunk, void *dst): any codec (raw/LZ77/EA), returns size
text_decode        = 0x01FF85C4   # (int string_id, char *buf, int maxlen)  [ITCM]
ea_decompress      = 0x01FF8C50   # (src, dst)                              [ITCM]

# --- game clock
game_time          = 0x0214112C   # game_time_t: the city clock
time_add           = 0x0201D994   # unsigned time_add(game_time_t *t, const game_time_t *delta)
time_update        = 0x02083DB0   # advances game_time by a delta, runs hourly/daily events
time_update_call   = 0x02083DC4   # the BL time_add inside time_update
world_tick         = 0x02084104   # runs once per game tick (30 per second)
time_speed_table   = 0x02113B5C   # game_time_t[]: [0] normal = +3 s per tick, [1] = +60 s
time_speed_index   = 0x021473F8   # u8: which table entry is in use

# --- game state (one big struct of globals at 0x02141120)
game_state         = 0x02141120   # base of the main game-state struct
money              = 0x02141124   # s32 Simoleons (game_state+4); HUD redraws on its own refresh flag
game_phase         = 0x02141C25   # u8 (game_state+0xB05); motives decay only when 3, except Fun
sim_flags          = 0x02141C30   # u16 per-sim flags (x16 entries); bit 2 = motives frozen (tutorial)

# --- motives (needs). Order: 0 hunger, 1 hygiene, 2 energy, 3 social,
#     4 comfort, 5 bladder, 6 fun, 7 room. Values are s32 8.24 fixed point, 0..100.
player_motives     = 0x02141204   # s32[8]
motive_get         = 0x0205DD60   # u8 motive_get(s32 *motives, int i)  -> 0..100
motive_rate        = 0x0205DD70   # s32 per-tick change for motive i (decay tables + modifiers)
motive_decay       = 0x0205E27C   # applies one tick of decay to a motive set
motive_apply_effect= 0x0205DC20   # (s32 *motives, int effect_row, int scale_idx): object/action gains
motive_decay_table = 0x020CEDA8   # s32[8] per-tick change, normal
motive_decay_table_b = 0x020CEDC8 # s32[8] per-tick change when sim+8 != 0 (about 6x faster)
motive_start_table = 0x020CEDE8   # s32[8] new-game starting motives
motive_effect_table= 0x020CEED4   # s32[rows][8] per-tick gains for each action row
motive_effect_scale= 0x020EA998   # s32[] multipliers (1.0, 1.2, 1.4 ...) by object quality

# --- shopping
upgrade_table      = 0x020C25BC   # [category][4 levels] of 12 bytes: s16 price, ...
buy_upgrade        = 0x02018DAC   # pays price, refunds half of the old level
sell_upgrade       = 0x02018D14

# --- save file (8 KB EEPROM: 0x20 header + 2 slots of 0xFE0; see urbz_save.py)
save_ctx           = 0x021470FC   # +0x20 slot buffer, +0x84 write cursor, +0x88 bit, +0x8C bytes used
save_write_bits    = 0x0207E944   # (const u8 *bits, int n)  one bit per input byte
save_write_nibbles = 0x0207E9CC   # (const u8 *vals, int n)  4 bits each
save_write_bytes   = 0x0207EAAC   # (const void *src, int n)
save_serialize_all = 0x020354BC   # writes the whole game into the slot buffer
save_finish_slot   = 0x0207EB28   # serialize + checksum (u16 at +0xFDE)
save_write_slot    = 0x0207E850   # (int slot) EEPROM write
save_read_slot     = 0x0207E87C   # (int slot) EEPROM read
save_slot_valid    = 0x0207E8A8   # (int slot) u16 sum == 0
save_read_bits     = 0x0207EC48   # (u8 *bits, int n)  mirror of save_write_bits
save_read_nibbles  = 0x0207ECBC   # (u8 *vals, int n)
save_read_bytes    = 0x0207ED78   # (void *dst, int n)  byte-aligns the cursor first, like save_write_bytes
save_deserialize_all = 0x020356D8 # reads the whole game from the slot buffer (mirror of save_serialize_all)
save_load_slot     = 0x0207EE00   # reset cursor, deserialize, count bytes (called from area_enter's load mode)
save_game          = 0x0207EBAC   # (int slot) serialize + write + read back + verify (the Save Game screen)
save_boot_init     = 0x0207EE88   # boot: check the header, read both slots (frame ~10, before the title)
save_boot_read_slots = 0x0207E8E8 # boot: read and check both slots
eeprom_read        = 0x02015860   # int (u32 offset, u32 len, void *dst)  cartridge save memory
eeprom_write       = 0x020157D4   # int (u32 offset, u32 len, const void *src)  returns 1 on success; locks the card itself
# hook sites used by the mod core (proven in the emulator 2026-10-02: boot frame 10-15, load and save see
# the cursor go 0 -> 2,569 bytes on city.sav). The game never writes save memory 0x1FE0-0x1FFF (0xFF on a real save).
save_boot_read_call = 0x0207EF00  # BL save_boot_read_slots in save_boot_init
save_serialize_call = 0x0207EB44  # BL save_serialize_all in save_finish_slot (slot buffer zeroed just before)
save_deserialize_call = 0x0207EE1C # BL save_deserialize_all in save_load_slot
world_tick_call    = 0x0204C06C   # the only BL world_tick (city update 0x0204C014)
area_enter_last_call = 0x0204C58C # last BL in area_enter (to 0x0204B19C), after the area and its people are set up
area_enter_finish  = 0x0204B19C
game_start         = 0x0204BA98   # first city entry after the title: loads the slot (load modes) or sets up a new game; runs once
game_start_call    = 0x0204C268   # the BL game_start in area_enter
new_game_init      = 0x02035C48   # new-game setup (seen once, from game_start, in a new game; not on a load)
# NitroSDK cache maintenance (r0 = address, r1 = size)
DC_FlushRange      = 0x020B7C70
DC_WaitWriteBufferEmpty = 0x020B7C8C
IC_InvalidateRange = 0x020B7C98

# --- people
talk_partner       = 0x021474F8   # u32 index of the character being talked to; name string = 481 + index

# --- people / NPCs. Character ids: 31 + c, where c = 0..35 is the person in name order
#     (name string 512 + c, bio 471 + c): 31 Bayou Boo ... 45 Kris Thistle ... 66 Sharona Faster.
current_area       = 0x02141FEC   # u32 id of the area (lot/street) on screen
npc_present        = 0x02065AD0   # bool npc_present(int char_id, int area, game_time_t *t)
npc_schedule_table = 0x020E4FD8   # u8 *[char_id - 31]: u8[24 hours][7 weekdays] = area id (0 = no table)
npc_busy_list      = 0x02142270   # 10 x {s16 active, u8 char_id, ...} (6 bytes): these NPCs are away
spawn_npc          = 0x0206499C   # entity *spawn_npc(int char_id, int facing, int x<<16, int y<<16)
spawn_from_record  = 0x02064ED8   # area placement record {u16 type 7, u16, s16 x, s16 y, u8 char, u8 facing}
relationships      = 0x02141154   # 36 x 4 bytes: [0] s8 relationship with person c (-128 = never met)
rel_flags          = 0x02141153   # u8 per person, 4 apart (just before relationships): 4 = friend (set when the relationship reaches 50, cleared below 50; count at 0x02141152), 2/1/8 other thresholds (add_relationship 0x0207B074)
bead_given         = 0x02141156   # u8 per person, 4 apart (relationships + 2): 1 = they gave you their Beads (set at 0x0208C268 with the "@2 gave you some Beads!" notice, 0x02141C70 queue flag 0x100); add_relationship at 75 reads it

# --- entities (people and objects on screen): pool of 0x148-byte structs from 0x0215E344.
#     +0x08 u16 type (0 player, 7 person), +0x0A u16 character id, +0x0C flags,
#     +0x18/+0x1C x/y (16.16), +0x4C behaviour function, +0x104 u8 state, +0x105 u8 action,
#     +0xC7 u8 animation, +0x146 u16 character id
entity_new         = 0x020062EC   # entity *entity_new(int type)
entity_set_state   = 0x02000E20   # (e, state)   +0x104
entity_set_action  = 0x02000E54   # (e, action)  +0x105
entity_play_anim   = 0x02000F34   # (e, anim)    player: 0x02037908, people: 0x020647E0
motive_failure     = 0x0205DEB8   # a need at 0 starts its failure action (accident, pass out...)
room_motive_tick   = 0x02083CB8   # pulls Room toward the area's score (rows 39/41)

# --- buyable objects (catalog). Index i is the same in both tables, 0x14 bytes per row.
object_text_table  = 0x020E6D48   # {u32 model id, u32 description string, u32 name string, u32 catalog page, u32 ?}
object_info_table  = 0x020E8B70   # {u32 price, u32 common, u32 uncommon, u32 rare, u32 ?}: shop masks, bit = list number
item_lists         = 0x02141280   # 24 x {u8 count, u8 cap, u16, slot *}; slots {u16 object, u8, u8 variant}, 0x184 empty
pockets_list       = 0x02141338   # item list 23 (game_state+0x154), 8 slots: shop buys land here
shop_defs          = 0x020C76E8   # 24 x {u8 cap, u8 n, u8 keep, u8, u16 *items}; item 0x183 = random pick
shop_pick          = 0x0203C53C   # (state, list): random object by rarity mask (60/30/10%)
game_rand          = 0x0207A118   # int (n): 0..n inclusive, from the Mersenne Twister rand_u32 0x02079E08
rand_left          = 0x02146EFC   # s32: numbers left before the twister refills (pointer at 0x02146F10); tests poke it to vary rolls
restock_shop       = 0x0203CA30   # (state, list)
restock_all        = 0x0203D370   # lists 0-20; new game and each new day
list_add           = 0x0203D0CC   # int (list *, object, u8, u8 variant)
shop_ui            = 0x02148F30   # shop screen state; +4 u8 = which list is shown
shop_buy           = 0x0209CDA8   # money check, list_add(pockets), add_stat(2, -price)
is_home_area       = 0x02046AF4   # (lots, area): can objects be placed in this area
home_lots          = 0x020C812C   # 7 x 8: {u8 area, 0, u8 area2, u8 area3 (82 none), u16 name string, u16}
home_lot           = 0x02141230   # u8 current lot (game_state+0x110), +1 u8 crate pending, +2 u16 unlocked extra lots
move_home          = 0x02046C7C   # (lots, lot): clear the old home, move in, things go into a crate
rent_sign_create   = 0x0204697C   # area record type 24 {.., u16 weekly (+8), u16 deposit (+0xA), u8 lot (+0xC)}
rent_sign_dialog   = 0x020463A8   # Yes: pay the deposit, move_home, weekly bills at 0x02141B8A, m0g5 sub 2 done
subgoal_set_done   = 0x020545A0   # (m, g, s) (I: from the rent dialog's call (0, 5, 2))
home_areas         = 0x020C812C   # 8-byte rows, 3 area bytes each
extra_lots         = 0x020C8110   # u8[11] areas, each usable when unlocked (FUN_02046878)

# --- stats, jobs
add_stat           = 0x02035350   # u32 add_stat(int kind, int delta): 0/1 = u16 counters at 0x02141B88/0x02141B86, 2 = money (max 999,999; refreshes the HUD)
money_max          = 999999
job_session_ptr    = 0x021420D0   # -> current job shift: +4 s16 Simoleons earned this shift, +0x11 job, +0x12 level
job_pay_call       = 0x020516AC   # BL add_stat(2, earned) when a shift ends
schedule_lookup    = 0x02065890   # u8 schedule_lookup(int char_id, game_time_t *t): area this person should be in (82 = out of town)
npc_relocate_tick  = 0x02066110   # every 150 ticks: people whose schedule says this area walk in, others walk out
schedule_lookup_call = 0x0206665C # the BL schedule_lookup inside npc_relocate_tick (hook point for NPC Life)
npc_present        = 0x02065AD0   # bool npc_present(id, area, time): quest overrides, busy list, date partner, then the schedule table
schedules_on       = 0x02142234   # u8: 0 = everyone always present (very start of a new game), 1 = schedules apply
npc_busy_list      = 0x02142270   # 10 x 6 bytes {s16 timer, u8 id, u8 area, u8 zone key, u8 state}: visits placed in a spawn zone; npc_present keeps them off their schedule
# literal pool words that hold &npc_schedule_table (npc_present reads the table directly, not via schedule_lookup)
schedule_table_ptr_1 = 0x02065888
schedule_table_ptr_2 = 0x02065924
schedule_table_ptr_3 = 0x02065AA0
schedule_table_ptr_4 = 0x0206610C
schedule_table_ptr_5 = 0x02066700

# --- goals (quests): 7 missions x 6 goals x 12 bytes; m = mission 0-6 (Goals menu 1-5; 5 = Rep Mission: the
#     groups Streeties, Nerdies, Artsies, Richies; 6 = S; seen in the emulator), g = goal 0-5
goal_table         = 0x02141940   # +0 u8 active, +1 u8 complete (set when you report back), +2+2s u8 sub-goal s shown, +3+2s u8 sub-goal s done
goal_active        = 0x02054334   # u8 goal_active(m, g)
goal_complete      = 0x020542F4   # u8 goal_complete(m, g)
subgoal_done       = 0x02054314   # u8 subgoal_done(m, g, s)
subgoal_shown      = 0x02054354   # u8 subgoal_shown(m, g, s)
goals_draw         = 0x02036708   # (m, g): the Goals screen's text for one goal; sub-goal s line = text_get(title string + s + 1)
goals_line_text    = 0x02036860   # BL text_get(sub-goal line) in goals_draw
relationship_base  = 0x02141134   # social table: relationships = base + 0x20
add_relationship   = 0x0207B074   # int add_relationship(base, char_id, delta): clamps -100..100, sets friend flags at 50

# --- areas (docs/areas.md). Area ids 0-79; name string = 975 + id; 82 = out of town
area_table         = 0x020C87E0   # 80 x 0x14: {ptr, u32 name string, u32 data asset game id, u8[4], u32}
area_gfx_table     = 0x020C8E20   # 80 x 0x50: graphics asset ids per area
area_entry_point   = 0x02141C28   # u8 entry point used when an area loads
area_variant       = 0x02122794   # u8 story variant: picks the area data section (0 tutorial, 1 after the first job)
area_enter         = 0x0204C158   # loads the area in current state param, spawns record groups 0 and 1
set_state          = 0x0204DF7C   # set_state(state, mode, param): doors call set_state(1, 0, area)
record_handlers    = 0x020C2308   # area record type -> create function (7 person, 3 door, 25 elevator, 29 NPC way point, 30 spawn zone)
spawn_record_group = 0x020125C0   # spawn one record group of the current area (0 and 1 at area load)
swap_record_groups = 0x02012690   # swap_record_groups(show, hide): scripts and objects switch groups 2+
npc_walk_out       = 0x020655C0   # person heads for the type-29 way point toward their next area
npc_walk_in        = 0x020656A4   # person appears on a type-29 way point (facing 4)
npc_walked_out     = 0x02065768   # (e): what the game does when someone reaches their way point out (with path_cancel and entity_set_state(e, 1)): leaving flag off, their visit done
spawn_in_zone      = 0x020644FC   # spawn_in_zone(id, key): random spot in the type-30 zone with that key

# --- player look (docs/player-look.md)
player_look        = 0x02141144   # u8[10]: gender, skin, hair style, hair colour, shirt style, shirt, overshirt, sleeve, pants, shoes colour
cab_hair_tables    = 0x0211CDAC   # Create-a-Bod hair part tables per gender -> u32[4 styles]
city_hair_tables   = 0x020F75D0   # city player hair tables per gender -> u32[4 styles] -> anim table u32[196]
build_player_palette = 0x02083538 # builds the player's 2 OBJ rows from assets 11543 (skin/hair/shoes) and 11542 (clothes)

# --- palettes and fonts
npc_palette_table  = 0x020D0054   # u32 palette game id per character id (Kris 45 -> file 09160)
street_palette_table = 0x020C82C4 # u32 game ids loaded into OBJ rows 2-8 on streets
entity_palette_table = 0x0206D724 # void (entity, const u32 *palette ids): draw it in a palette of its own (row from the people pool)
own_palette_check  = 0x02068258   # in object setup: "bne" unless the object is 61 (Personal Painting, variants 0xFD)
own_palette_call   = 0x02068264   # in object setup: BL entity_palette_table(e, 0x020F58EC) for object 61
set_palette_row    = 0x0206D84C   # void set_palette_row(entity, row): entity+0x90 bits 12-15 (row 0xFF = leave it)
load_palette_row   = 0x0206D73C   # people: take a free/shared row from the pool and load a 16-colour palette into it
obj16_rows         = 0x020C2828   # u32[5]: OBJ palette row per variant for area record type 16 (pick-ups)
obj16_sprites      = 0x020C2838   # 5 x {gfx, layout, palette, param} sprite records for record type 16
obj31_rows         = 0x020C2B08   # u32[6]: OBJ palette row per variant for area record type 31
font_table         = 0x020C5CEC   # 8 x {u32 font game id, u32 colour base}
font_descriptors   = 0x02140D60   # 8 x 0x28 resident font descriptors

# --- bottom-screen menus (Urb Info / Options / globe ...; docs/systems.md "Menus")
menu_table_ptrs    = 0x020F5654   # menu *[5]: 0 Urb Info (0x020F5744, the city's default), 1 catalog pages, 2 Options (0x020F56EC), 3 ?, 4 ? (index = menu_ui+8; proven 2026-11-20)
options_menu       = 0x020F56EC   # header {u32 gfx, u32 layout, 0, 0, u32 pal16, u32 pal256, u16 count, u16} + count x 20-byte buttons
menu_ptr_lit_1     = 0x0206FD54   # literal pool words holding &menu_table_ptrs (the only references)
menu_ptr_lit_2     = 0x020701B4
menu_ptr_lit_3     = 0x020703B0
menu_ptr_lit_4     = 0x020706BC
menu_ui            = 0x02144CEC   # -> {+4 open, +8 menu index, +0xC action, +0x10 selected button}
menu_hit_test      = 0x0206FBF4   # int (): touched button -> its action (0 = open sub-menu index in word 3, then -1); -1 = none
menu_hit_call      = 0x0206FDAC   # the only BL menu_hit_test
menu_redraw        = 0x0207026C   # rebuild the open menu's icons and text
menu_draw_text     = 0x02070038   # title + one label per button
menu_label_call    = 0x0207016C   # BL text_get(button label id) in menu_draw_text
menu_dispatch_call = 0x0206FDE4   # the touch handler's BL menu_dispatch (after str action -> menu_ui+0xC); it returns after unless the action is 0x22
menu_dispatch      = 0x02070494   # run the chosen action (6 settings, 7 save, 0x28 quit, ...)
text_get           = 0x020A6D28   # const char *text_get(int string_id)
text_draw          = 0x020340F8   # (int tiles, int x, int y, const char *s, int align: 1 centre x, 2 right, 4 centre y)
text_width         = 0x0203458C   # int (const char *s): width in pixels with the current font
text_font          = 0x02034754   # (int font, int colour, -1): font slot for the following text_draw calls
ui_sound           = 0x02097B58   # (int id): 1 select, 3 refused, 4 open sub-menu
touch_state        = 0x02141D70   # +0x0E u16 x, +0x10 u16 y, +0x52 u16 touched this frame


# --- people: movement and object use (Phase 6)
npc_state_dispatch = 0x0200BE50   # (e): switch on e+0x104 (state) -> handler; 0x22 walk out, 0x23 wander, 0x26 go to object
npc_wander_state   = 0x0200A1F0   # state 0x23: action 7 stand (timer +0x108), 0x19 walk a random line, 0x29 gesture, 0x2d path to e+0x38, 0x3e use an object
npc_goto_object_state = 0x0200D584 # state 0x26: path result +0x10b: 1 arrived -> object starts activity +0x122, 3 failed -> action 0x13 (back to e+0x10a state)
npc_pick_object    = 0x02008A18   # int (e, &obj_entity, &activity): object in this area whose activity serves a need (mask 0x76) below 31; needs e+0x114
npc_use_object     = 0x02067C68   # int (obj_entity, person, activity): checks, then npc_goto_object
npc_goto_object    = 0x0200D720   # int (person, obj_entity, activity): use spot, path there, state 0x26, action 3, anim 0x0A
npc_can_use_objects = 0x02066960  # u8 (id): person record +0x36 (only 33 39 41 52 54 58 in the original)
npc_record         = 0x02066858   # (id): 0x38-byte record, table 0x020E5E5C (+0x36 = may use objects)
path_request       = 0x0207DC08   # int (e, s32 xy[2] (16.16), u8 *result, 0): 3 slots (0x02146F1C, 0xA0 each); result 2 walking, 1 arrived, 3 failed
path_cancel        = 0x0207DB10   # (e): frees e's path slot
object_class_table = 0x020EAF84   # 0x24 bytes per object number: +4 list activities, +8 can start, +0xC start, +0x1C usable by
object_list_head   = 0x0214490C   # first node of this area's objects: {next, ?, u16 object number @+8, ..., entity @+0x24}
activity_need_table = 0x020EA9B0  # u32 per activity: which need it serves (u16)
entity_lists       = 0x02121AF0   # {u32 head, u32 first} per context (8 bytes); context 0 = the world (people, objects); entity +0 = next
path_count         = 0x02146F18   # u8 path slots in use (of 3); npc_goto_object does not check, so check first
npc_end_activity   = 0x02000D70   # (e, activity record): drops it from e+0x100 (no clean-up; prefer the stop byte)
entity_face        = 0x02000F08   # (e, dir 1-8): clockwise, 8 = up (screen), 3 = down-right, 7 = up-left
npc_has_anim       = 0x020644A8   # int (id, anim): in the person's animation list (0x0211CDF4, 12-byte rows, ends 0xC4)
npc_anim_lists     = 0x0211CDF4   # u8 *[id]: {u8 anim, ...} x 12 bytes; 0x6B sit / 0x7B toilet only for 33 39 41 45 52 53 54 58
player_body_setup  = 0x0208327C   # (e, look): fills drawing slots 0-3 (+0xCC, 12 bytes: +1 palette row, +8 anim table) from the look, index e+0xC7
load_look_palette  = 0x020833E0   # (look, row_a, row_b): builds the player's 2 palette rows from a look into OBJ rows a (skin/hair) and b (clothes)
entity_set_frames  = 0x02003130   # (e, anim, facing record): picks the facing's records (player: facing from player_facing_table[e+0x12])
entity_sort_bounds = 0x02001314   # (e): e+0x60..0x66 = where it stands for the draw sort (+0x5C callback of people, objects use their footprint; the game's critters have none: bounds 0)
entity_set_mirror  = 0x020032D4   # (e, n): mirror the sprite when e+0x12 (facing) > n (+0x8C bit 28); the game calls it with 4 after turning an entity (entity_face doesn't)
entity_set_script  = 0x02002B68   # (e, frame script, start): the animation's frame sequence (+0xA0)
player_gfx_refresh = 0x020374B8   # the player's graphics update: body setup, frames, script when e+0x106 & 0x14
player_facing_table = 0x020C22B4  # s8 per direction (0x020C22C8 when e+0xC bit 29 is set)
player_scripts_a   = 0x021204EC   # u32[anim] frame scripts (game_state+0x24 == 0)
player_scripts_b   = 0x0211EC5C   # u32[anim] frame scripts (game_state+0x24 != 0)
player_body_tables = 0x020F75E0   # u32[gender] -> u32[196] body anim tables (0 = no such animation)
entity_layered     = 0x020031F4   # (e): e+0xC5 |= 0x40 (draw from 4 slots, like the player) and resets the slots (+0xD2 = 0xFFFF: no sprite memory yet)
asset_load         = 0x02032B08   # int (game id, unpack): loads into asset_ptrs; ids >= the count literal are refused
asset_offsets      = 0x0212352C   # u32[13386]: rom.bin's index (read at boot); moved by urbz_build when mods add assets
asset_ptrs         = 0x02130654   # u32[13386]: where each loaded asset is (0 = not loaded)
asset_refs         = 0x0213D77C   # u8[13386]: use counts
pet_slots          = 0x02141BA2   # 3 x 0x18 bytes: the player's pets (+0 kind, 0x11 = empty; +2 colour; +3 affection?)
spawn_pet_record   = 0x020729A4   # area record type 6: param 0x0D-0x0F = pet slot 0-2, 0x10 = best pet, else a kind
spawn_pet          = 0x0207272C   # entity *(kind, x<<16, y<<16, slot): entity type 6
pet_anim_lists     = 0x0211D680   # u32 *[kind] -> u32[anim] -> 5 facing records {gfx, layout, palette, param}
pet_palettes       = 0x020F5F04   # u32[kind 0-7][3 colours]: palette game ids
pet_speed          = 0x020C1AFC   # s32 per kind (16.16)
critter_table      = 0x020C3400   # 0x14 x 7 kinds: {setup fn, ?, ?, speed, flags}; entity type 9 (chicken = kind 1)
critter_anims      = 0x020C348C   # 0x28 x 7: 5 animations x {5-facing records, frame script}
critter_palettes   = 0x020C2FD4   # u32 palette game id per critter kind
spawn_critter      = 0x0202AB18   # entity *(kind, facing, ?, x, y)
critter_pickup     = 0x0202A0DC   # critter state 0x12 (being picked up), action 0x0E: -> Pockets (kind 1 -> 225, 5 -> 236)
critter_behaviour  = 0x0202A61C   # critter entity update (+0x4C): switch on state +0x104
place_object_check = 0x0203F698   # can this object go here: numbers >= 224 only 225 (chicken, max 6 per lot)
pet_object_removed = 0x02065224   # class +0x14 for objects 225/236/237: object 225 -> spawn_critter(1, ...)

# --- objects and critters (Phase 8)
place_check_call   = 0x0203E054   # BL place_object_check in the carry/place code (0x0203DF08)
critter_pick_kind  = 0x0202A2D8   # critter_pickup: "cmp r0(kind), #5" after the chicken case
critter_pick_done  = 0x0202A2FC   # "cmp r5, #1": r5 = list_add result (1 = in Pockets, the critter goes)
critter_pick_nutria = 0x0202A2E0  # the Dancing Nutria case (object 236)
obj_text_lit       = 0x02014130   # a literal holding object_text_table (moved by urbz_objects.py)
shop_pick_count_lit = 0x0203C6AC  # literal: how many object numbers exist (386; urbz_objects raises it)
placed_store_ptr   = 0x021418BC   # u8 *: placed objects of all areas (game_state+0x138+0x664): u16 total, 160 x 10-byte records {u16 object, ...} from +2, per area (82) u8 first @+0x642+4a, u8 count @+0x643+4a; read by 0x0203D5F8
obj_class_lit      = 0x02008BE8   # a literal holding the class table (moved by urbz_objects.py)
object_class_table = 0x020EAF84   # the game's own class table (0x24 per object): +4 activities(node, u8 out[7]), +8 can start(node, person, activity), +0xC start(node, person, activity), +0x10 tick(node, person) -> 0/2 ends, +0x23 u8 quality (0-5)
object_user_record = 0x02069520   # rec *(node, person): the person's use of the object (node+0xC, 2 x 12 bytes: person, u16 activity +4, u16 phase +6, u8 stop +8, u8 path +9)
object_use_continue = 0x020691D0  # int (rec, needs, need, s16 *timer): 0 = the use ends (need full and the timer ran out, or stop byte 1); the object ticks ask it every tick of the use
pockets_ptr        = 0x02141274   # game_state+0x154: -> Pockets (item list 23)
object_shapes      = 0x020E6954   # u32 per placeable object (0-252): footprint data
object_models      = 0x020F1D28   # u32 per placeable object: art (model data); 0 = not drawn
object_variants    = 0x020F211C   # 5 x u32 per placeable object (colour variants)
object_anims       = 0x020F34E0   # 0x1C per placeable object (7 art pointers: the default look, ...); right after object_variants
catalog_loop_1     = 0x0201C6E8   # cmp r6, #0x118: the Catalog lists objects 0-279
catalog_loop_2     = 0x0201C920   # cmp sl, #0x118
ui_sprite_table    = 0x020CB134   # 16-byte records {gfx gid, layout gid, palette gid, param} by sprite id; object icons use the object's model number (~632 rows)
critter_play_anim  = 0x02029804   # (critter, slot): records by facing (critter_facing_map) + frame script
critter_walk_kind  = 0x0202A73C   # critter_behaviour, starting to move: "ldrh r0,[r4,#0xA]; cmp r0,#1" (walk anim only for the Chicken)
critter_stop_kind  = 0x0202A760   # same when it stops (stand anim only for the Chicken)
critter_tap        = 0x0202A4F8   # critter_table +8 for the chicken/rooster: the player at it (state 0x10) -> pick up (state 0x12)
critter_tap_kind   = 0x0202A570   # "ldrh r2,[r5,#0xA]; ldr r1,=0xFFFF" then kind-1 <= 1: only kinds 1-2 can be picked up
critter_facing_map = 0x020C22B4   # u8[8]: facing -> direction 0-4 (0 1 2 3 4 3 2 1)
# --- Phase 9: pets (docs/systems.md "Pets")
entity_records     = 0x02003254   # (e, record): an animation's facing record {gfx, layout, palette, param} (critter_play_anim)
entity_stop        = 0x02001D00   # (e): stop moving
entity_go          = 0x02001D18   # (e): move forward (facing, speed +0x14)
entity_dir_to      = 0x020018A4   # int (a, b): the direction from a to b, for entity_face
entity_faces       = 0x020013A8   # int (a, b): b lies in the direction a faces (no distance check)
entity_flag_clear  = 0x02000EB0   # (e, bits): e+0xC &= ~bits; bit 1 = alive (cleared: the entity goes)
person_touch       = 0x02071CE0   # (person, other): a townsperson's touch callback; the player facing them (state 0x10) + A starts a chat
person_touch_lit   = 0x02072914   # the literal the game installs person_touch from
screen_state       = 0x027C009C   # u32 per screen (x0x8C), & ~0x80: what the screen shows (1 = the city, 2 = a box)
ui_sprite_new      = 0x0204EBF4   # u8 *(ui, icon, palette, layer): a UI sprite; a message box's icon = (0xF1, icon model, 0xF, 0) at dialog_flags+8
message_box        = 0x0203A084   # (icon model, string): the game's plain message box (sets @1 to the player's name)
dialog_open        = 0x02078530   # (): opens the top-screen question box (state 2) from dialog_text
dialog_text        = 0x02146EB8   # u16[5] per screen (x10 bytes): question string, then up to 4 option strings
dialog_flags       = 0x02146ECC   # u8[12] per screen: +0 lines drawn, +3 flags, +4 1 = no highlight, +8 u8 * the box's icon sprite (plain messages)
dialog_result      = 0x027C00D4   # u32 per screen (x0x8C): option picked 1-4, 0x7FFFFFFF = cancelled (B)
screen_index       = 0x027C0004   # u32: the screen (0 top, 1 bottom) being run
input_state        = 0x02141D70   # +10 u16 keys pressed this frame (1 A, 2 B, 0xF0 D-pad)
pockets_list       = 0x02141338   # item list 23: {u8 count, u8 capacity, u16, slots *} slots {u16 object, u8, u8 variant} (6 bytes)
crit_table_lit     = 0x0202AC1C   # a literal holding critter_table (moved by urbz_pets.py; code/pets finds the pet list before it)
can_save           = 0x0206F8C4   # (): 1 if Save Game / Quit may open: player state 0x10 (or game phase != 3), action != 5, top screen state 1, ...; else menu_hit_test buzzes
dialog_arg         = 0x02033B78   # (const char *text, int slot): fills @1 (slot 0), @2, @3 of the next box (64 bytes each at 0x02140EA0 + screen*0x100)
social_options     = 0x02147508   # u8[4] the chat's choices: code < 0x4A = string 3732+code (0x43 Flirt, 0x44 Hug, 0x45 Kiss), 0x4A FRIENDLY STUFF, 0x54 empty (docs/systems.md "Chats")
social_draw_options = 0x0208DC1C  # draws the 4 choices
social_pick_options = 0x0208F230  # draws choices 1-3 at random; Flirt/Kiss re-drawn when npc_sex == player sex (0x0208F3BC)
npc_sex            = 0x02066A28   # u8 (char_id): person record +0x27, 0 male 1 female
phone_activity     = 0x020A5168   # the home phone's object activity (state in use record +6)
phone_open         = 0x020A4D94   # builds phone_list (known people by name), opens Call Services / Call Friend / Invite (at home)
people_known       = 0x0207AB3C   # (social_book, s8 *out, max, min, max_rel [stack]) -> count: ids 31-66 met, min <= relationship <= max_rel (phone_open: 36, -100, 100)
social_book        = 0x0214114E   # what people_known reads (relationships = +6)
phone_names_page   = 0x020A4B7C   # 4 names from phone_page
phone_names_box    = 0x020A4C8C   # (): the box of 4 names from phone_page, item 0 "next" (top screen state 2); phone_activity states 0x1C / 0x1D read dialog_result
phone_call         = 0x020A495C   # (list index, use record): where they'll be, +1 relationship, face, dialog_open
phone_invite       = 0x020A477C   # (list index, use record): chance rel/2+10, npc_visit_home, dialog_open
phone_list         = 0x02148F48   # s8[36] person ids (31-66; name = string 481 + id), -1 = end
phone_count        = 0x02148F44   # u8
phone_page         = 0x02148F40   # u8 first entry shown
phone_services_box = 0x020A4CFC   # (): the Call Services question box (top screen, set_state_here(2)); phone_activity state 0x1B reads dialog_result 0-2
service_order      = 0x020A4F74   # (service 0/2/3, use record): price check (game_state+0x81C row x 0x18 + 0x020C1F40); too dear: message, phone_service = 4, record +6 = 0x1E; else the answer box, record +6 = 0x1F
service_call       = 0x020647D0   # (service 0/2/3): sends the service (phone_activity state 0x1E, on hanging up)
phone_service      = 0x02148F3C   # u8: the Call Services choice (0-2), 4 = none
phone_anims        = 0x0211BDF4   # u8[3 rows][4 kinds][3]: pick up, hang up, end {facing, object look (6 = none), player anim}; kind = phone node+0x3B (0 pay phone 212: 0x52 / 0x53; 1-3 home 205-207: 0x51 / 4)
object_set_look    = 0x02067D04   # (object entity, look): one of the object's 7 looks (object_anims), e.g. the pay phone's handset off (1)
face_image         = 0x0204E5A4   # (c): image id of the person's face (ui_sprite_new(0xF1, img, 0xF, 0))
ui_slot_pos        = 0x020CA88C   # s16 x, y, x2, y2 per UI sprite slot (ui_sprite_new's first argument)
ui_sprite_update   = 0x0204E7B8   # UI sprites' update (+0x4C): puts them at their slot's place each frame
entity_set_pos     = 0x02001DAC   # (e, x << 16, y << 16)
entity_set_frame   = 0x02001DC0   # (e, frame): reloads only when the frame differs from +0x97
npc_visit_home     = 0x02064768   # (c): the person comes to the player's home (visit zone 0, 3,600 ticks)
# --- object touch screens: the mixer and oven screen (docs/systems.md "Object touch screens"; read from the code)
screen_block       = 0x027C0000   # per screen x 0x8C: +0x74 mode, +0x78 sub-screen to draw first, +0x84 sub-screen (update), +0xD4 dialog_result
set_state_here     = 0x0204E028   # (state, mode, param): set_state for the screen being run
set_state_other    = 0x0204DEFC   # (state, mode, param): set_state for the other screen
obj_screen_enter   = 0x02028888   # state 31 (bottom) enter: background + title from obj_screen_modes[mode], buttons, ingredients
obj_screen_update  = 0x02028814   # state 31 update: by sub-screen (+0x84) 0 -> 1, 1 touches, 3, 4
obj_screen_buttons = 0x0202859C   # state 31 enter: mode's sprites, the round button (hidden) and the close button (slot 0x10)
obj_screen_draw    = 0x02027D90   # (part): 0xD the title, 0xE the 8 ingredients, 0-10 the slots
obj_screen_touch   = 0x02027290   # sub-screen 1: ingredient touches, close button -> set_state(0x22) + other screen set_state(1, 2, area)
obj_screen_modes   = 0x020C2BF4   # 16 bytes per mode {bg gfx 3, bg gfx 2, ?, title string}: 0 Basic Mixer, 1 Deluxe, 2 Oven, 3-7 unused copies of 0, 8-11 wood carving
obj_help_enter     = 0x02024D94   # state 37 (top) enter: title (row +0xC) and help text (163 carving, 164 mixer, 165 oven)
obj_buttons        = 0x02142014   # u8 *[20] per screen (x 0x50): the touch screen's buttons; 0x10 = close
map_fill           = 0x020180FC   # (layer, x, y, w, h, value) in tiles: fills part of a screen's tile map (the mixer clears its panel with (1, 1, 12, 16, 7, 0))
text_wrap          = 0x02034328   # (tiles, x, y, width, s, align): text wrapped to width px (the touch screens' panel, the help text)
where_is           = 0x0206592C   # int (person id, u32 *area, u8 *hour, u8 *day): where the timetable has them now; area 0x52 = out of town
button_new         = 0x0206F6F4   # u8 *(kind, palette, 0, shown, x << 16, y << 16): a round button, frame kind * 3, placed by its centre
button_hit         = 0x0206F5E8   # int (slot): touched this frame inside 30 x 30 around obj_buttons[slot]
return_spot        = 0x02141C2C   # {player *, ..., +7 u8 facing, +8 s16 x, +0xA s16 y}: where the player stands when the city comes back with area_entry_point = 0xFF (the mixer sets both)
# --- the player's walk style (2026-11-19, mods/walk-style)
walk_pick          = 0x02037860   # int (anim): the player's animation for anim; 10 (walk) becomes the Rep group's walk when sim_flags[input_state+4] & 0x20 and !player_walk_busy(0): group 0 Streeties 0x0E, 1 Nerdies 0x0C, 2 Richies 0x0D, 3 Artsies 0x0B, 4 (none) 0x0A
walk_pick_call     = 0x02037930   # in player_play_anim (0x02037908): bl walk_pick
walk_pick_call2    = 0x020095A4   # in FUN_02009484 (the player's set-up): bl walk_pick(10), then entity_play_anim
player_walk_busy   = 0x020377DC   # int (anim): 1 if sim_flags & 8, 2 if (0x02141B20+0xFC) & 0x1000 (0 for anim 0xFB), else 0
rep_groups         = 0x02141240   # s8 rep[4] (+0..3, per group), +0x14 s32 the player's group (0-3, 4 = none); group_of(char) 0x0207CCC0 (table 0x020F6F34, 4 x 8 ids)
# --- power-on: logos, title, Load-an-Urb (2026-11-20, mods/quick-start; docs/systems.md "Power-on: logos to the city")
state_table        = 0x020CD8B4   # 43 rows {enter, update, exit} (set_state's states); row 3 = the logos, 5 = title, 7 = Load-an-Urb, 1 = city
state_logos_update = 0x02045640   # state 3 update (runs on screen 0 only): logos; stage 0xD puts 0x21 on screen 0 and the title (5) on screen 1
cur_screen         = 0x027C0004   # u32: the screen whose state is running (0 = top: the city; 1 = bottom: its menus); set_state_other flips it around set_state_here
screen_blocks      = 0x027C0070   # per screen (x 0x8C): +0 state, +4 mode, +8 param; +0x2C state | 0x80 (pending), +0x30 mode, +0x34 param; phase bytes at 0x027C006C + screen (frame loop in ITCM 0x01FF89F0)
screen_fade        = 0x020807B0   # (mask, kind): the kind of the next fade (per screen, 0x02147190); the logos start with 1
screen_level       = 0x0208093C   # (mask, level): sets the fade level now (0x0214719C per screen; 0 = shown, 16 = dark, as the logos leave it)
fade_busy          = 0x02080654   # int (): nonzero while either screen is fading (the logos wait for 0 between steps)
game_reset         = 0x02035D5C   # (): clears the game globals and allocates the placed-objects buffer (game_state+0x664 via 0x0203D8F4); the title top (state 0x21 enter, 0x020AB840) calls it; a load before it writes through a 0 pointer
sound_card_pause   = 0x02098420   # (): stops the sound stream before a card read (the load screen's save_read_slot)
sound_card_resume  = 0x02098388   # (): starts it again
save_slot_info     = 0x02141F80   # u8 *: +4 + slot = 1 if the slot holds a game (Load-an-Urb checks it); still 0 at the logos (filled later)
save_card_busy     = 0x02141F7C   # u8: 1 while the load screen reads a slot
load_transition    = 0x027C0064   # u8: the load screen sets 1 before the city's set_state (a transition kind, read at 0x0204DC44)
load_confirm       = 0x0204781C   # Load-an-Urb (state 7, screen 1) confirm: save_ctx+0x80 = slot, read, check, set_state_other(1, 5, 0), set_state_here(0x22)
# --- chat replies (2026-11-20, mods/friendly-topics; docs/systems.md "Chats")
social_pick_call   = 0x0208E3D8   # in FUN_0208E2F4 (a chat opens): bl social_pick_options
social_pick_call2  = 0x0208E064   # in FUN_0208E05C (FRIENDLY STUFF deals new choices): bl social_pick_options
social_replies     = 0x02114698   # per person (id 31-66) x 0x274: 8-byte entry per topic {u32 text, s8 relationship change, u8 anim}; entry = code * 8, but 0x15 -> 0xB0, 0x16 -> 0xA8, 0x43 -> 0x230, 0x46 -> 0x238 (social_reply_entry 0x0208ABF4)
social_replies_alt = 0x02114014   # used instead for person 31 when game_state+0x959 is set
social_reply_entry = 0x0208ABF4   # (person, code): the topic's reply entry; social_reply 0x0208D888 adds entry+4 to the relationship (social_add_rel 0x0208FFF4)
social_add_rel     = 0x0208FFF4   # (change): change + rep_bonus(rep_groups, rep_group_of(partner)) -> add_relationship; > 0 happy, < 0 unhappy
rep_group_of       = 0x0207CCC0   # int (person id): Rep group 0-3, 4 = none
rep_bonus          = 0x0207CC3C   # int (rep_groups, group): -2..+2 from the player's standing with that group (0 for group 4)
# --- the moving crate (2026-11-20, mods/moving-crate, proof `moving-crate`; docs/systems.md "The moving crate")
crate_list_ptr     = 0x02141278   # game_state+0x158: -> item list 21 (the crate, 50 slots; header 0x02141328)
objects_mgr        = 0x02141258   # game_state+0x138: placed-objects manager (+0x20 -> crate list, +0x664 store)
pack_home          = 0x0203C774   # (objects_mgr, area): placed things of an area -> crate list, then clear the area
store_remove       = 0x0203C82C   # (objects_mgr, area, index in area): drop one placed-object record (the burglar uses it)
list_has_room      = 0x0203CEB0   # bool (list *): count < capacity
list_is_full       = 0x0203CECC   # bool (list *): count >= capacity
list_is_empty      = 0x0203CEE8   # bool (list *)
list_remove        = 0x0203CFB0   # (list *, index, 1): take a slot out, the rest move up
list_find          = 0x0203D08C   # int (list *, object): slot index or -1
crate_here         = 0x02046948   # u8 (): in the home lot's main area and game_state+0x111 set (asked before the crate's area record is made)
crate_spawn_call   = 0x020684F4   # BL crate_here in the area-record object spawn (0x020684A4), only for object 230
crate_list_acts    = 0x020624D8   # class 230 +4: Open the Crate (0x0F); Return the Crate (0x10) only when the crate is empty
crate_empty_call   = 0x020624F0   # BL list_is_empty(crate list) in crate_list_acts
crate_dispatch     = 0x020623DC   # class 230 +0xC: 0x0F -> crate_open 0x020622E4 (shop screen, list 21), 0x10 -> crate_return 0x020622A4
crate_return_call  = 0x02062418   # BL crate_return in crate_dispatch
shop_sell          = 0x0209CC50   # int (): the shop screen's sell; lists 21/22: no price, the item goes into list 21
shop_input         = 0x0209BA50   # shop screen (state 17) input; a double-tap on a Pockets item skips lists 21/22 (0x0209BB0C/14)
shop_sell_call     = 0x0209BB18   # BL shop_sell in shop_input
pockets_use        = 0x0203DF08   # Pockets double-tap: use item (0x0203FA80) or place check -> carry mode (state 0x16)
pockets_enter      = 0x0204036C   # bottom state 13 (Pockets; mode 8 Collectibles) enter: panel 0x288D on BG1, text 0x286D
pockets_update     = 0x02040244   # state 13 update
pockets_leave      = 0x020401C4   # state 13 leave
city_menu_enter    = 0x0207121C   # bottom state 0x22 enter: the frame 0x286E on BG3 (BG control 0x1F11)
layers_off         = 0x02018494   # (0): the current screen's BG layers off
display_on         = 0x02018410   # (bits): turn on (0x1000 = sprites)
layer_setup        = 0x020185E8   # (layer, BG control): set a layer up and turn it on
layer_clear        = 0x020183EC   # (layer, 0): clear a layer's map
bg_load            = 0x02017CF4   # (layer, picture, palette row, 0, 0, 0): a picture's tiles, map and palette onto a layer
pal_load           = 0x02017990   # (palette, row): a 16-colour palette into a BG palette row
text_layer         = 0x02034884   # (BG control): text_draw draws on the layer with this control

# --- the object menu (docs/systems.md "The player using an object")
object_menu_build  = 0x02067760   # (player): fills the choices (u8 activity[7] at entity+0x132: the object's, then Put in Pocket 0x2C and Move 0x25 at home) and opens the question box; returns 0 when there are none
object_menu_open_call = 0x02067A10 # in object_menu_build: BL set_state_here(2) wrapper (0x0204E038) that opens the box; the player (state 0xF) reads dialog_result (0-based index into entity+0x132) one tick after it closes (0x020675F4)
object_menu_result = 0x020675F4   # (player, state 0xF action 0x38): dialog_result -> Put in Pocket / Move / the object's start(node, player, activity); 0x7FFFFFFF = cancelled

# --- the chat's touch screen (docs/systems.md "The chat screen"; mod better-chat)
ui_mode            = 0x0204E0AC   # int (): the running screen's state; 0x24 = a chat
chat_touch         = 0x0208B280   # int (): touched part (0-3 topic rows, 4 up arrow, 5 down arrow, 6 green tick, 7 back; -1 none); hit rectangles at 0x02119F54
chat_keys          = 0x0208B0A0   # int (): D-pad moves the selected row (dlg+0x78), A with a row selected returns 1
chat_touch_call    = 0x02090984   # state 1 (the topic list): BL chat_touch
chat_keys_call     = 0x020909F8   # state 1: BL chat_keys
chat_touch_call3   = 0x02090E5C   # state 3 (a reply): BL chat_touch; 6 (tick) or 7 (back) goes on
chat_touch_call5   = 0x0209111C   # states 5-7 (a reply / the quest and gift boxes): BL chat_touch; 6 (tick) or A goes on
chat_icons         = 0x0208EF78   # (): sets the 4 topic icons from social_options
chat_icons_call    = 0x0208E3DC   # a chat opens: BL chat_icons (after social_pick_options)
chat_icons_call2   = 0x0208E068   # FRIENDLY STUFF deals new choices: BL chat_icons
sprite_anim        = 0x02001DC0   # (sprite, n): sprite animation n (a topic row: 0 normal, 1 selected, 2 pressed)
sprite_reload      = 0x0204E79C   # (sprite): redraw after its frame (+0xA) changed
sprite_palette     = 0x02000E54   # (sprite, row): sprite palette row (+0x105)
chat_sprites       = 0x02142014   # u32 [..]: +0x50 green tick, +0x54 up arrow, +0x58 down arrow, +0x5C back, +0x60..0x6C topic rows, +0x70..0x7C topic icons (frame 0x19C + topic code)
dlg_ui             = 0x027C0000   # +4 buffer index n; per buffer (n * 0x8C): +0x74 mode (4 = special), +0x78 selected row (-1 none), +0x84 state (1 = the topic list)
chat_update        = 0x0209092C   # the chat screen's state machine (dlg+0x84: 0 topic list, 1 FRIENDLY STUFF's sub-menu, 5 a reply ...)
sprite_new         = 0x0204EBF4   # (id, frame, palette row 0-15, priority 0-3) -> sprite: id sets the start place (table 0x020CA88C), flags 0x200019 (shown); taken from the pool of screen_index (0x02006264: 0x02122300 + screen * 0x210); the pool is reset by the chat's screen init
sprite_place       = 0x02001DAC   # (sprite, x << 16, y << 16)
chat_init          = 0x0208B548   # the chat screen's init (resets the sprite pool, builds the buttons: 0x0208B314)
obj_palette_b      = 0x05000600   # the bottom screen's sprite palette (16 rows x 16 colours; chat: 0 tick, 1-2 arrows, 3 back, 9-12 the topic icons)

# --- collectibles: 0 Pile of Trash, 1 Aluminum Cans, 2 License Plate, 3 Nuclear Fuel Rods, 4 Three-Eyed Bog Frog
#     (name string 210 + kind, description 215 + kind). docs/systems.md "Collectibles and the trash bug".
collectible_spawn  = 0x0201DF70   # area record type 16 {u16 16, u16, s16 x, s16 y, u8 kind, u8 slot 0-63}: once a day per slot, chance collectible_chance[kind]; kind 0 never if trash_picked > 100
collectible_pick   = 0x0201DC50   # the collectible's behaviour: picking it up adds 1 to objects_mgr+4+kind (0x0203CF68) and, for trash, trash_picked++
collectible_day    = 0x0201DF50   # daily: clears the rolled/spawned-today bits (game_state+0xA18..0xA27)
collectible_chance = 0x020C2820   # u8[5] percent: 60 50 40 30 20
collectible_count  = 0x0214125C   # u8[5] how many you hold (objects_mgr+4), capped at 250
trash_picked       = 0x02141B48   # u8 (game_state+0xA28): trash piles ever picked up; saved (0x0201DE88). Over 100: no trash spawns again
artsie_trash_sold  = 0x0214126A   # u8 (game_state+0x14A): trash sold while goal (5,2) sub-goal 2 is shown; 100 = done (shop_input)
